+// HTTP range seeks can wait for decoder/streaming locks during FLUSH. Keep
+// that event dispatch off the WebProcess main thread. SVP, looping and rate
+// changes retain their existing dispatch policy.
+static bool localBooruShouldDispatchSeekAsync(GstElement* pipeline, bool isHTTP, bool isLooping, bool isChangingRate)
+{
+    if (!isHTTP || isLooping || isChangingRate)
+        return false;
+    auto* iterator = gst_bin_iterate_recurse(GST_BIN(pipeline));
+    GValue item = G_VALUE_INIT;
+    bool hasInterpolation = false;
+    bool done = false;
+    while (!done) {
+        switch (gst_iterator_next(iterator, &item)) {
+        case GST_ITERATOR_OK: {
+            auto* element = GST_ELEMENT(g_value_get_object(&item));
+            auto* factory = gst_element_get_factory(element);
+            hasInterpolation = factory && !g_strcmp0(gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)), "localbooruvs");
+            g_value_reset(&item);
+            done = hasInterpolation;
+            break;
+        }
+        case GST_ITERATOR_RESYNC:
+            gst_iterator_resync(iterator);
+            break;
+        case GST_ITERATOR_ERROR:
+            hasInterpolation = true; // Unknown graph keeps the existing policy.
+            done = true;
+            break;
+        case GST_ITERATOR_DONE:
+            done = true;
+            break;
+        }
+    }
+    if (G_VALUE_TYPE(&item))
+        g_value_unset(&item);
+    gst_iterator_free(iterator);
+    return !hasInterpolation;
+}
+
+static void localBooruAcceptHTTPSeek(GstElement* pipeline, bool isHTTP, bool isLooping, bool isChangingRate)
+{
+    if (!localBooruShouldDispatchSeekAsync(pipeline, isHTTP, isLooping, isChangingRate))
+        return;

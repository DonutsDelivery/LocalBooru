+    auto generation = GPOINTER_TO_SIZE(g_object_get_data(G_OBJECT(pipeline), "localbooru-http-seek-generation")) + 1;
+    g_object_set_data(G_OBJECT(pipeline), "localbooru-http-seek-generation", GSIZE_TO_POINTER(generation));
+}

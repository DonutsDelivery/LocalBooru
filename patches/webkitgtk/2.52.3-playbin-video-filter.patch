+bool GraphicsContextGLTextureMapperANGLE::copyTextureFromVideoFrame(VideoFrame& videoFrame, PlatformGLObject texture, GCGLenum target, GCGLint level, GCGLenum internalFormat, GCGLenum format, GCGLenum type, bool premultiplyAlpha, bool flipY)
+{
+#if USE(GSTREAMER_GL)
+    if (!is<VideoFrameGStreamer>(videoFrame) || target != TEXTURE_2D)
+        return false;
+
+    auto& gstFrame = downcast<VideoFrameGStreamer>(videoFrame);
+    GRefPtr<GstBuffer> convertedBuffer;
+    auto* memory = rgbGLMemoryFromVideoFrame(gstFrame, format, convertedBuffer);
+    if (!memory)
+        return false;
+
+    if (!makeContextCurrent() || !enableExtensionsImpl({ "GL_ANGLE_texture_external_update"_s, "GL_CHROMIUM_copy_texture"_s }))
+        return false;
+
+    ScopedRestoreTextureBinding restoreBinding(TEXTURE_BINDING_2D, TEXTURE_2D);
+    ScopedTexture sourceTexture;
+    GL_BindTexture(TEXTURE_2D, sourceTexture);
+    auto size = gstFrame.presentationSize();
+    GL_TexImage2DExternalANGLE(TEXTURE_2D, 0, internalFormat, size.width(), size.height(), 0, format, type);
+
+    GCGLint nativeSourceTexture = 0;
+    GL_GetTexParameteriv(TEXTURE_2D, GL_TEXTURE_NATIVE_ID_ANGLE, &nativeSourceTexture);
+    auto outputFormat = format == RGB ? GST_GL_RGB : GST_GL_RGBA;
+    if (!nativeSourceTexture || !gst_gl_memory_copy_into(GST_GL_MEMORY_CAST(memory), nativeSourceTexture, GST_GL_TEXTURE_TARGET_2D, outputFormat, size.width(), size.height()))
+        return false;
+
+    GL_InvalidateTextureANGLE(TEXTURE_2D);
+    // GStreamer GL textures use the opposite vertical origin from DOM video
+    // sources, so the WebGL unpack flip is inverted for this direct copy.
+    GL_CopyTextureCHROMIUM(sourceTexture, 0, target, texture, level, internalFormat, type, !flipY, premultiplyAlpha, false);
+    return GL_GetError() == NO_ERROR;
+#else
+    UNUSED_PARAM(videoFrame);
+    UNUSED_PARAM(texture);
+    UNUSED_PARAM(target);
+    UNUSED_PARAM(level);
+    UNUSED_PARAM(internalFormat);
+    UNUSED_PARAM(format);
+    UNUSED_PARAM(type);
+    UNUSED_PARAM(premultiplyAlpha);
+    UNUSED_PARAM(flipY);
+#endif
     return false;
 }
 #endif


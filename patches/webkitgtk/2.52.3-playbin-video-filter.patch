+namespace {
+
+struct LocalBooruRelayConnection {
+    int client;
+    int upstream;
+};
+
+static bool localBooruSendAll(int socket, const char* data, size_t size)
+{
+    while (size) {
+        auto written = send(socket, data, size, MSG_NOSIGNAL);
+        if (written < 0 && errno == EINTR)
+            continue;
+        if (written <= 0)
+            return false;
+        data += written;
+        size -= written;
+    }
+    return true;
+}
+
+static gpointer localBooruRelayConnection(gpointer userData)
+{
+    auto* connection = static_cast<LocalBooruRelayConnection*>(userData);
+    int sockets[2] { connection->client, connection->upstream };
+    delete connection;
+    char buffer[16384];
+
+    while (true) {
+        pollfd descriptors[2] { { sockets[0], POLLIN, 0 }, { sockets[1], POLLIN, 0 } };
+        auto result = poll(descriptors, 2, -1);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            break;
+
+        bool closed = false;
+        for (unsigned index = 0; index < 2; ++index) {
+            if (!(descriptors[index].revents & (POLLIN | POLLHUP | POLLERR)))
+                continue;
+            auto bytesRead = recv(sockets[index], buffer, sizeof(buffer), 0);
+            if (bytesRead <= 0 || !localBooruSendAll(sockets[1 - index], buffer, bytesRead)) {
+                closed = true;
+                break;
+            }
+        }
+        if (closed)
+            break;
+    }
+
+    close(sockets[0]);
+    close(sockets[1]);
+    return nullptr;
+}
+
+static int localBooruConnectUnixSocket(const char* path)
+{
+    int socketDescriptor = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (socketDescriptor < 0)
+        return -1;
+
+    sockaddr_un address { };
+    address.sun_family = AF_UNIX;
+    if (strlen(path) >= sizeof(address.sun_path)) {
+        close(socketDescriptor);
+        return -1;
+    }
+    strcpy(address.sun_path, path);
+    if (connect(socketDescriptor, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0) {
+        close(socketDescriptor);
+        return -1;
+    }
+    return socketDescriptor;
+}
+
+static bool localBooruPrivateHostFile(const std::string& path, std::string& value)
+{
+    struct stat metadata { };
+    if (lstat(path.c_str(), &metadata) || !S_ISREG(metadata.st_mode)
+        || metadata.st_uid != geteuid() || metadata.st_size > 256)
+        return false;
+    gchar* contents = nullptr;
+    gsize length = 0;
+    if (!g_file_get_contents(path.c_str(), &contents, &length, nullptr))
+        return false;
+    value.assign(contents, length);
+    g_free(contents);
+    return true;
+}
+
+static bool localBooruIsActiveVideoHost(const char* root)
+{
+    std::string active;
+    if (!localBooruPrivateHostFile(std::string(root) + "/active", active))
+        return false;
+    auto separator = active.find('\n');
+    if (separator == std::string::npos)
+        return false;
+    auto id = active.substr(0, separator);
+    constexpr const char* prefix = "localbooru-svp-host-";
+    if (id.compare(0, strlen(prefix), prefix) || id.size() <= strlen(prefix) || id.size() > strlen(prefix) + 80)
+        return false;
+    for (auto character : id.substr(strlen(prefix))) {
+        if (!g_ascii_isalnum(character) && character != '-')
+            return false;
+    }
+    auto pidEnd = active.find('\n', separator + 1);
+    if (pidEnd == std::string::npos || active.substr(separator + 1, pidEnd - separator - 1) != std::to_string(getpid()))
+        return false;
+    // Epoch/revision must be complete positive decimal fields. Partial or
+    // malformed writes cannot advertise a host.
+    auto cursor = pidEnd + 1;
+    for (unsigned field = 0; field < 2; ++field) {
+        auto end = active.find('\n', cursor);
+        if (end == std::string::npos || end == cursor || end - cursor > 20)
+            return false;
+        bool nonzero = false;
+        for (auto character : active.substr(cursor, end - cursor)) {
+            if (!g_ascii_isdigit(character))
+                return false;
+            nonzero |= character != '0';
+        }
+        if (!nonzero)
+            return false;
+        cursor = end + 1;
+    }
+    if (cursor != active.size())
+        return false;
+    std::string registered;
+    return localBooruPrivateHostFile(std::string(root) + "/" + id, registered)
+        && registered == std::to_string(getpid()) + "\n";
+}
+
+static void localBooruRemoveOwnedSocket(const char* path, ino_t inode)
+{
+    struct stat metadata { };
+    if (inode && !lstat(path, &metadata) && S_ISSOCK(metadata.st_mode)
+        && metadata.st_uid == geteuid() && metadata.st_ino == inode)
+        unlink(path);
+}
+
+static std::atomic<bool> localBooruMpvIdentityReady { false };
+static gboolean localBooruMarkVideoHostAsMpv(gpointer)
+{
+    prctl(PR_SET_NAME, "mpv", 0, 0, 0);
+    localBooruMpvIdentityReady.store(true);
+    return G_SOURCE_REMOVE;
+}
+
+static gpointer localBooruMpvControlRelay(gpointer userData)
+{
+    GUniquePtr<char> upstreamPath(static_cast<char*>(userData));
+    const char* hostRoot = g_getenv("LOCALBOORU_MPV_CONTROL_HOST_ROOT");
+    if (!hostRoot || !*hostRoot)
+        return nullptr;
+    // SVP's mpvSockets discovery supports concurrent players. Never claim its
+    // single-player /tmp/mpvsocket or remove another process's PID entry.
+    constexpr const char* directory = "/tmp/mpvSockets";
+    std::string publicPath = std::string(directory) + "/" + std::to_string(getpid());
+    int listener = -1;
+    ino_t ownedInode = 0;
+    bool identityRequested = false;
+
+    while (true) {
+        if (!localBooruIsActiveVideoHost(hostRoot)) {
+            if (listener >= 0) {
+                close(listener);
+                listener = -1;
+                localBooruRemoveOwnedSocket(publicPath.c_str(), ownedInode);
+                ownedInode = 0;
+            }
+            g_usleep(250000);
+            continue;
+        }
+        if (!identityRequested) {
+            // Process identity belongs to the main thread, not this relay thread.
+            g_idle_add(localBooruMarkVideoHostAsMpv, nullptr);
+            identityRequested = true;
+        }
+        if (!localBooruMpvIdentityReady.load()) {
+            g_usleep(25000);
+            continue;
+        }
+        if (listener < 0) {
+            if (mkdir(directory, 0700) && errno != EEXIST)
+                return nullptr;
+            struct stat metadata { };
+            if (lstat(directory, &metadata) || !S_ISDIR(metadata.st_mode) || metadata.st_uid != geteuid())
+                return nullptr;
+            if (!lstat(publicPath.c_str(), &metadata)) {
+                if (!S_ISSOCK(metadata.st_mode) || metadata.st_uid != geteuid())
+                    return nullptr;
+                if (auto existing = localBooruConnectUnixSocket(publicPath.c_str()); existing >= 0) {
+                    close(existing);
+                    return nullptr;
+                }
+                // Only an owned stale entry with this process's exact PID.
+                localBooruRemoveOwnedSocket(publicPath.c_str(), metadata.st_ino);
+            }
+            listener = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+            if (listener < 0)
+                return nullptr;
+            sockaddr_un address { };
+            address.sun_family = AF_UNIX;
+            if (publicPath.size() >= sizeof(address.sun_path)) {
+                close(listener);
+                return nullptr;
+            }
+            strcpy(address.sun_path, publicPath.c_str());
+            if (bind(listener, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0 || listen(listener, 8) < 0) {
+                close(listener);
+                return nullptr;
+            }
+            if (lstat(publicPath.c_str(), &metadata)) {
+                close(listener);
+                return nullptr;
+            }
+            ownedInode = metadata.st_ino;
+            chmod(publicPath.c_str(), S_IRUSR | S_IWUSR);
+        }
+        pollfd descriptor { listener, POLLIN, 0 };
+        int ready = poll(&descriptor, 1, 250);
+        if (ready < 0 && errno == EINTR)
+            continue;
+        if (ready < 0)
+            break;
+        if (!ready || !localBooruIsActiveVideoHost(hostRoot))
+            continue;
+        int client = accept4(listener, nullptr, nullptr, SOCK_CLOEXEC);
+        if (client < 0)
+            continue;
+        int upstream = localBooruConnectUnixSocket(upstreamPath.get());
+        if (upstream < 0) {
+            close(client);
+            continue;
+        }
+        auto* connection = new LocalBooruRelayConnection { client, upstream };
+        g_thread_unref(g_thread_new("DMC mpv control", localBooruRelayConnection, connection));
+    }
+    if (listener >= 0)
+        close(listener);
+    localBooruRemoveOwnedSocket(publicPath.c_str(), ownedInode);
+    return nullptr;
+}
+
+static gboolean startLocalBooruMpvControlRelay(gpointer data)
+{
+    g_thread_unref(g_thread_new("LocalBooru mpv listener", localBooruMpvControlRelay, data));
+    return G_SOURCE_REMOVE;
+}
+
+static void startLocalBooruMpvControlRelayIfNeeded()
+{
+    const char* upstreamPath = g_getenv("LOCALBOORU_MPV_CONTROL_UPSTREAM_V2");
+    if (!upstreamPath || !*upstreamPath || !g_getenv("LOCALBOORU_MPV_CONTROL_HOST_ROOT"))
+        return;
+    // SVP Manager applies some player-specific capabilities (including NVOF)
+    // from the process identity behind its PID socket. This WebProcess is the
+    // actual graph host and mpv-compatible endpoint, so expose that identity
+    // consistently with the protocol it implements.
+    // WebKit assigns its process name after platformInitialize(). Start from
+    // the main loop so the compatibility identity is the final one observed
+    // through SO_PEERCRED and /proc by SVP Manager.
+    g_timeout_add(250, startLocalBooruMpvControlRelay, g_strdup(upstreamPath));
+}

         if (auto* scale = makeGStreamerElement("scaletempo"_s))
             g_object_set(m_pipeline.get(), "audio-filter", scale, nullptr);
     }
+
+    // Deinterlacing doubles the frame-processing work and most LocalBooru
+    // content is progressive. Keep it off, especially for the WebGL VR path.
+    guint playFlags = 0;
+    g_object_get(m_pipeline.get(), "flags", &playFlags, nullptr);
+    constexpr guint playFlagDeinterlace = 1U << 9;
+    g_object_set(m_pipeline.get(), "flags", playFlags & ~playFlagDeinterlace, nullptr);
+
+    const char* videoFilterName = g_getenv("WEBKIT_GST_VIDEO_FILTER");
+    GUniquePtr<char> videoFilterNameFromFile;
+    if ((!videoFilterName || !*videoFilterName)) {
+        if (const char* videoFilterFile = g_getenv("WEBKIT_GST_VIDEO_FILTER_FILE")) {
+            char* contents = nullptr;
+            if (g_file_get_contents(videoFilterFile, &contents, nullptr, nullptr)) {
+                videoFilterNameFromFile.reset(contents);
+                videoFilterName = g_strstrip(videoFilterNameFromFile.get());
+            }
+        }
+    }
+    if (videoFilterName && *videoFilterName) {
+        if (auto* videoFilter = makeGStreamerElement(CStringView::unsafeFromUTF8(videoFilterName))) {
+            GST_INFO_OBJECT(pipeline(), "Using application video filter: %s", videoFilterName);
+            g_object_set(m_pipeline.get(), "video-filter", videoFilter, nullptr);
+        } else
+            GST_WARNING_OBJECT(pipeline(), "Unable to create application video filter: %s", videoFilterName);
+    }

+static GstMemory* rgbGLMemoryFromVideoFrame(VideoFrameGStreamer& gstFrame, GCGLenum format, GRefPtr<GstBuffer>& keepAlive)
+{
+    auto* sample = gstFrame.sample().get();
+    auto* buffer = sample ? gst_sample_get_buffer(sample) : nullptr;
+    auto* caps = sample ? gst_sample_get_caps(sample) : nullptr;
+    auto* memory = buffer ? gst_buffer_peek_memory(buffer, 0) : nullptr;
+    if (!memory || !caps)
+        return nullptr;
+
+    const bool alreadyRGBGL = gst_is_gl_memory(memory)
+        && GST_VIDEO_INFO_IS_RGB(&gstFrame.info())
+        && GST_VIDEO_INFO_N_PLANES(&gstFrame.info()) == 1;
+    if (alreadyRGBGL)
+        return memory;
+
+    auto* glContext = PlatformDisplay::sharedDisplay().gstGLContext();
+    if (!glContext)
+        return nullptr;
+
+    const char* inputFormat = gst_video_format_to_string(GST_VIDEO_INFO_FORMAT(&gstFrame.info()));
+    const char* rgbFormat = format == GraphicsContextGL::RGB ? "RGB" : "RGBA";
+    if (!inputFormat)
+        return nullptr;
+
+    GRefPtr<GstBuffer> glBuffer(buffer);
+    if (!gst_is_gl_memory(memory)) {
+        static GstGLUpload* upload = nullptr;
+        static GstGLContext* uploadContext = nullptr;
+        static GRefPtr<GstCaps> lastInCaps;
+        static GRefPtr<GstCaps> lastOutCaps;
+        if (upload && uploadContext != glContext) {
+            gst_object_unref(upload);
+            upload = nullptr;
+            lastInCaps = nullptr;
+            lastOutCaps = nullptr;
+        }
+        if (!upload) {
+            upload = gst_gl_upload_new(glContext);
+            uploadContext = glContext;
+        }
+        if (!upload)
+            return nullptr;
+
+        auto outCaps = copyCapsAsGLMemory(caps, inputFormat);
+        if (!lastInCaps || !gst_caps_is_equal(lastInCaps.get(), caps) || !lastOutCaps || !gst_caps_is_equal(lastOutCaps.get(), outCaps.get())) {
+            if (!gst_gl_upload_set_caps(upload, caps, outCaps.get()))
+                return nullptr;
+            lastInCaps = caps;
+            lastOutCaps = WTF::move(outCaps);
+        }
+
+        GstBuffer* uploaded = nullptr;
+        auto result = gst_gl_upload_perform_with_buffer(upload, buffer, &uploaded);
+        if (result != GST_GL_UPLOAD_DONE || !uploaded)
+            return nullptr;
+        glBuffer = adoptGRef(uploaded);
+        memory = gst_buffer_peek_memory(glBuffer.get(), 0);
+        if (!memory || !gst_is_gl_memory(memory))
+            return nullptr;
+    }
+
+    static GRefPtr<GstGLColorConvert> colorConvert;
+    static GstGLContext* convertContext = nullptr;
+    static GRefPtr<GstCaps> lastConvertInCaps;
+    static GRefPtr<GstCaps> lastConvertOutCaps;
+    if (colorConvert && convertContext != glContext) {
+        colorConvert = nullptr;
+        lastConvertInCaps = nullptr;
+        lastConvertOutCaps = nullptr;
+    }
+    if (!colorConvert) {
+        colorConvert = adoptGRef(gst_gl_color_convert_new(glContext));
+        convertContext = glContext;
+    }
+    if (!colorConvert)
+        return nullptr;
+
+    auto convertInCaps = copyCapsAsGLMemory(caps, inputFormat);
+    auto convertOutCaps = copyCapsAsGLMemory(caps, rgbFormat);
+    if (!lastConvertInCaps || !gst_caps_is_equal(lastConvertInCaps.get(), convertInCaps.get())
+        || !lastConvertOutCaps || !gst_caps_is_equal(lastConvertOutCaps.get(), convertOutCaps.get())) {
+        if (!gst_gl_color_convert_set_caps(colorConvert.get(), convertInCaps.get(), convertOutCaps.get()))
+            return nullptr;
+        lastConvertInCaps = WTF::move(convertInCaps);
+        lastConvertOutCaps = WTF::move(convertOutCaps);
+    }
+
+    GstBuffer* converted = gst_gl_color_convert_perform(colorConvert.get(), glBuffer.get());
+    if (!converted)
+        return nullptr;
+    keepAlive = adoptGRef(converted);
+    memory = gst_buffer_peek_memory(keepAlive.get(), 0);
+    if (!memory || !gst_is_gl_memory(memory))
+        return nullptr;
+    return memory;
+}
+#endif

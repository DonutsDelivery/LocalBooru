+// Only DMC's private, per-process bridge may cross the nested Flatpak sandbox.
+// The UI process creates this before starting WebKit; /tmp is not shared here.
+static const char* localBooruFlatpakBridgeRoot()
+{
+    const char* root = g_getenv("LOCALBOORU_SVP_SNAPSHOT_ROOT");
+    if (!root || !g_path_is_absolute(root))
+        return nullptr;
+    GUniquePtr<gchar> canonical(realpath(root, nullptr));
+    if (!canonical || strcmp(canonical.get(), root))
+        return nullptr;
+    GUniquePtr<gchar> name(g_path_get_basename(root));
+    constexpr const char* prefix = "localbooru-svp-snapshots-";
+    if (!g_str_has_prefix(name.get(), prefix) || !name.get()[strlen(prefix)])
+        return nullptr;
+    struct stat metadata { };
+    if (lstat(root, &metadata) || !S_ISDIR(metadata.st_mode)
+        || metadata.st_uid != geteuid() || (metadata.st_mode & 0777) != 0700)
+        return nullptr;
+    return root;
+}

+static GstElement* localBooruComposeVideoFilter(const LocalBooruResizeContract* resize, GstElement* filter)
+{
+    if (!resize || !resize->width || !resize->height)
+        return filter;
+    GstElement* scale = gst_element_factory_make("videoscale", nullptr);
+    GstElement* caps = gst_element_factory_make("capsfilter", nullptr);
+    GstElement* bin = gst_bin_new(nullptr);
+    if (!scale || !caps || !bin) {
+        if (scale) gst_object_unref(scale);
+        if (caps) gst_object_unref(caps);
+        if (bin) gst_object_unref(bin);
+        return filter;
+    }
+    gst_bin_add_many(GST_BIN(bin), scale, caps, nullptr);
+    bool linked = gst_element_link(scale, caps);
+    if (filter) {
+        gst_bin_add(GST_BIN(bin), filter);
+        linked = linked && gst_element_link(caps, filter);
+    }
+    GstPad* sink = gst_element_get_static_pad(scale, "sink");
+    GstPad* source = gst_element_get_static_pad(filter ? filter : caps, "src");
+    if (!linked || !sink || !source) {
+        if (sink) gst_object_unref(sink);
+        if (source) gst_object_unref(source);
+        gst_object_unref(bin);
+        return nullptr;
+    }
+    auto* probe = new LocalBooruResizeProbe { *resize, GST_ELEMENT(gst_object_ref(caps)) };
+    gst_pad_add_probe(sink, GST_PAD_PROBE_TYPE_EVENT_DOWNSTREAM, localBooruResizeCaps, probe, [](gpointer data) {
+        auto* probe = static_cast<LocalBooruResizeProbe*>(data);
+        gst_object_unref(probe->capsFilter);
+        delete probe;
+    });
+    gst_element_add_pad(bin, gst_ghost_pad_new("sink", sink));
+    gst_element_add_pad(bin, gst_ghost_pad_new("src", source));
+    gst_object_unref(sink);
+    gst_object_unref(source);
+    return bin;
+}

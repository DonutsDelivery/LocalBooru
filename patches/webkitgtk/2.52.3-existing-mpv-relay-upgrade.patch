+// DMC raw resolution is scoped to one physical video host, independently of SVP.
+struct LocalBooruResizeContract {
+    guint64 epoch { 0 };
+    guint64 revision { 0 };
+    guint width { 0 };
+    guint height { 0 };
+    std::string geometryPath;
+};
+
+static bool localBooruReadResizeContract(const char* id, LocalBooruResizeContract& contract)
+{
+    const char* root = g_getenv("LOCALBOORU_MPV_CONTROL_HOST_ROOT");
+    if (!root || !*root || !localBooruValidVideoHostId(id))
+        return false;
+    auto readPrivate = [](const std::string& path, std::string& result) {
+        struct stat metadata { };
+        if (lstat(path.c_str(), &metadata) || !S_ISREG(metadata.st_mode)
+            || metadata.st_uid != geteuid() || metadata.st_size > 256)
+            return false;
+        gchar* contents = nullptr;
+        gsize size = 0;
+        if (!g_file_get_contents(path.c_str(), &contents, &size, nullptr))
+            return false;
+        result.assign(contents, size);
+        g_free(contents);
+        return true;
+    };
+    std::string path = std::string(root) + "/" + id;
+    std::string raw, selected;
+    if (!readPrivate(path + ".resize", raw) || !readPrivate(std::string(root) + "/resize-active", selected))
+        return false;
+    gchar** fields = g_strsplit(raw.c_str(), "\n", -1);
+    bool valid = g_strv_length(fields) == 5 && !*fields[4];
+    guint64 values[4] { };
+    for (unsigned index = 0; valid && index < 4; ++index) {
+        if (!*fields[index]) { valid = false; break; }
+        for (const char* character = fields[index]; *character; ++character)
+            if (!g_ascii_isdigit(*character)) { valid = false; break; }
+        if (!valid) break;
+        char* end = nullptr;
+        errno = 0;
+        values[index] = g_ascii_strtoull(fields[index], &end, 10);
+        valid = !errno && end && !*end;
+    }
+    g_strfreev(fields);
+    if (!valid || !values[0] || !values[1]
+        || !((!values[2] && !values[3]) || (values[2] >= 2 && values[2] <= 16384 && values[3] >= 2 && values[3] <= 16384)))
+        return false;
+    std::string expected = std::string(id) + "\n" + std::to_string(values[0]) + "\n" + std::to_string(values[1]) + "\n";
+    if (selected != expected)
+        return false;
+    contract = { values[0], values[1], static_cast<guint>(values[2]), static_cast<guint>(values[3]), path + ".geometry" };
+    return true;
+}

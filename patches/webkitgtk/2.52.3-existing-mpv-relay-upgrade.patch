+static void localBooruRemoveOwnedSocket(const char* path, ino_t inode)
+{
+    struct stat metadata { };
+    if (inode && !lstat(path, &metadata) && S_ISSOCK(metadata.st_mode)
+        && metadata.st_uid == geteuid() && metadata.st_ino == inode)
+        unlink(path);
+}

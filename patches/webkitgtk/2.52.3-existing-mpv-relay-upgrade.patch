+static bool localBooruPrivateHostFile(const std::string& path, std::string& value)
+{
+    struct stat metadata { };
+    if (lstat(path.c_str(), &metadata) || !S_ISREG(metadata.st_mode)
+        || metadata.st_uid != geteuid() || metadata.st_size > 256)
+        return false;
+    gchar* contents = nullptr;
+    gsize length = 0;
+    if (!g_file_get_contents(path.c_str(), &contents, &length, nullptr))
+        return false;
+    value.assign(contents, length);
+    g_free(contents);
+    return true;
+}
+
+static bool localBooruIsActiveVideoHost(const char* root)
+{
+    std::string active;
+    if (!localBooruPrivateHostFile(std::string(root) + "/active", active))
+        return false;
+    auto separator = active.find('\n');
+    if (separator == std::string::npos)
+        return false;
+    auto id = active.substr(0, separator);
+    constexpr const char* prefix = "localbooru-svp-host-";
+    if (id.compare(0, strlen(prefix), prefix) || id.size() <= strlen(prefix) || id.size() > strlen(prefix) + 80)
+        return false;
+    for (auto character : id.substr(strlen(prefix))) {
+        if (!g_ascii_isalnum(character) && character != '-')
+            return false;
+    }
+    auto pidEnd = active.find('\n', separator + 1);
+    if (pidEnd == std::string::npos || active.substr(separator + 1, pidEnd - separator - 1) != std::to_string(getpid()))
+        return false;
+    // Epoch/revision must be complete positive decimal fields. Partial or
+    // malformed writes cannot advertise a host.
+    auto cursor = pidEnd + 1;
+    for (unsigned field = 0; field < 2; ++field) {
+        auto end = active.find('\n', cursor);
+        if (end == std::string::npos || end == cursor || end - cursor > 20)
+            return false;
+        bool nonzero = false;
+        for (auto character : active.substr(cursor, end - cursor)) {
+            if (!g_ascii_isdigit(character))
+                return false;
+            nonzero |= character != '0';
+        }
+        if (!nonzero)
+            return false;
+        cursor = end + 1;
+    }
+    if (cursor != active.size())
+        return false;
+    std::string registered;
+    return localBooruPrivateHostFile(std::string(root) + "/" + id, registered)
+        && registered == std::to_string(getpid()) + "\n";
+}

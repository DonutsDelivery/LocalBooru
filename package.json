{
  "name": "localbooru",
  "version": "2.0.0",
  "description": "Local image library with automatic tagging",
  "private": true,
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "tauri:build:debug": "cargo tauri build --debug",
    "tauri:build:linux": "./scripts/build-linux-local.sh",
    "tauri:build:linux:appimage": "./scripts/build-linux-local.sh --appimage",
    "tauri:build:linux:deb": "./scripts/build-linux-local.sh --deb",
    "tauri:build:linux:rpm": "./scripts/build-linux-local.sh --rpm",
    "release:linux": "./scripts/build-linux-local.sh",
    "release:windows": "./scripts/build-windows-local.sh"
  },
  "keywords": ["booru", "image-gallery", "tagger", "tauri"],
  "license": "MIT"
}
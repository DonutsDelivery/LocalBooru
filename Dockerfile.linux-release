# Reproducible LocalBooru Linux release toolchain.
# Source is bind-mounted by scripts/build-linux-local.sh; this image contains
# toolchains and distribution development packages only.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/lib/ccache:${PATH}

# Enable source repositories so apt can install WebKitGTK's complete build
# dependency set for the Ubuntu baseline used by the final packages.
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && apt-get build-dep -y webkit2gtk \
 && apt-get install -y --no-install-recommends \
      build-essential clang lld cmake ninja-build ccache pkg-config git curl \
      ca-certificates xz-utils patch file zip unzip patchelf desktop-file-utils \
      dpkg-dev rpm cpio ruby ruby-dev rubygems squashfs-tools libfuse2 fuse \
      python3 python3-dev python3-venv cython3 meson nasm \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      librsvg2-dev libssl-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad gstreamer1.0-libav \
      nlohmann-json3-dev libavformat-dev libavcodec-dev libavutil-dev \
      libswscale-dev libswresample-dev libva-dev libsdl2-dev \
      libegl1-mesa-dev libgles2-mesa-dev \
 && gem install --no-document fpm \
 && rm -rf /var/lib/apt/lists/*

# Vite 7 requires a current Node runtime. Pin the major release while keeping
# npm's lockfile as the JavaScript dependency source of truth.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
 && cargo install tauri-cli --version 2.9.4 --locked

# Ubuntu 24.04's Cython 3.0.8 emits private PyLong access when Meson requests
# Python 3.12's limited API. VapourSynth R75 needs a newer generator.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m pip install --break-system-packages --no-cache-dir 'Cython==3.2.8'

RUN mkdir -p /build /dist /ccache \
 && chown -R 1000:1000 /build /dist /ccache

USER 1000:1000
WORKDIR /build
CMD ["/bin/bash"]
